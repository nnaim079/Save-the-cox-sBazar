using UnityEngine;

[RequireComponent(typeof(MeshFilter))]
public class OceanWaveController : MonoBehaviour
{
    [Header("Wave Dimensions")]
    public float waveHeight = 0.8f;     
    public float waveFrequency = 0.35f; 
    public float waveSpeed = 2.2f;       

    [Header("Secondary Wave (Micro Details)")]
    public float secondaryHeight = 0.25f; 
    public float secondaryFrequency = 0.8f;

    private Mesh mesh;
    private Vector3[] baseVertices;
    private Vector3[] modifiedVertices;

    void Start()
    {
        MeshFilter meshFilter = GetComponent<MeshFilter>();
        mesh = meshFilter.mesh;
        baseVertices = mesh.vertices;
        modifiedVertices = new Vector3[baseVertices.Length];
    }

    void Update()
    {
        float time = Time.time * waveSpeed;

        for (int i = 0; i < baseVertices.Length; i++)
        {
            Vector3 v = baseVertices[i];
            
            
            Vector3 worldPos = transform.TransformPoint(v);

            
            float wave1 = Mathf.Sin((worldPos.x * waveFrequency) + (worldPos.z * waveFrequency * 0.7f) + time) * waveHeight;
            
            
            float wave2 = Mathf.PerlinNoise((worldPos.x * secondaryFrequency) + time * 0.5f, (worldPos.z * secondaryFrequency) + time * 0.5f) * secondaryHeight;

            
            v.y = baseVertices[i].y + wave1 + wave2;
            modifiedVertices[i] = v;
        }

        mesh.vertices = modifiedVertices;
        mesh.RecalculateNormals(); 
    }
}